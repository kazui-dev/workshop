#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=_common.sh
source "$SCRIPT_DIR/_common.sh"

require_installed_services
run_as_root systemctl stop "$WORKSHOP_TARGET"
run_as_root systemctl restart pigpiod.service
run_as_root systemctl start "$WORKSHOP_TARGET"
"$SCRIPT_DIR/status"
